<?xml version="1.0"?>
<package format="3">
  <name>fast_lio</name>
  <version>1.0.0</version>
  <description>ROS 2 Livox MID-360S FAST-LIO with timestamp-aware PointCloud2 and built-in IMU.</description>
  <maintainer email="sirobo@example.com">Workspace maintainer</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>livox_ros_driver2</depend>
  <depend>tf2_ros</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
