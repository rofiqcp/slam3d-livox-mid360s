<?xml version="1.0"?>
<package format="3">
  <name>slam3d_relocalizer</name>
  <version>0.1.0</version>
  <description>ROS2 map-based 3D LiDAR relocalization and pose tracking against a saved P4 PCD map.</description>
  <maintainer email="sirobo@example.com">sirobo</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend><depend>nav_msgs</depend><depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend><depend>std_msgs</depend><depend>std_srvs</depend>
  <depend>diagnostic_msgs</depend><depend>tf2_ros</depend>
  <depend>pcl_conversions</depend><exec_depend>ros2launch</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>